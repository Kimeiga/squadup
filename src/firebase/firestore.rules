rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/products/{productId} {
      allow get: if signedIn();
      allow list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/friends/{friendId} {
      allow get, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/friend-requests/{requestId} {
      allow get, list: if isOwner(userId);
      // Untrusted clients may not submit requests to another user's inbox.
      // Use a validated, abuse-protected backend when re-enabling sending.
      allow create: if false;
      allow update, delete: if isOwner(userId);
    }

    match /squads/{squadID} {
      // Public squads remain browseable, but arbitrary clients may no longer
      // create, replace, or delete shared sessions until ownership is enforced.
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}
